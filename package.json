{
  "name": "cavitour",
  "private": true,
  "version": "1.0.0",
  "description": "CaviTour monorepo — mobile (Expo), marketing web + embedded admin at /admin (Vite), optional standalone admin on :3001",
  "workspaces": [
    "apps/*"
  ],
  "overrides": {
    "vite": "^7.3.1",
    "react-router-dom": "^7.13.0",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "scripts": {
    "mobile": "npm run start --workspace=cavitour-mobile",
    "mobile:clear": "npm run start:clear --workspace=cavitour-mobile",
    "mobile:lan": "npm run start:lan --workspace=cavitour-mobile",
    "mobile:android": "npm run android --workspace=cavitour-mobile",
    "mobile:ios": "npm run ios --workspace=cavitour-mobile",
    "mobile:lint": "npm run lint --workspace=cavitour-mobile",
    "start": "npm run mobile",
    "dev": "npm run dev --workspace=cavitour-web",
    "web": "npm run dev --workspace=cavitour-web",
    "web:build": "npm run build --workspace=cavitour-web",
    "web:preview": "npm run preview --workspace=cavitour-web",
    "admin": "npm run dev --workspace=cavitour-admin",
    "admin:build": "npm run build --workspace=cavitour-admin",
    "admin:preview": "npm run preview --workspace=cavitour-admin",
    "build:icons": "node scripts/build-jam-svgs.mjs",
    "reset-project": "node scripts/reset-project.js",
    "cavite:import": "node scripts/import-sta-cavite-v3.mjs",
    "cavite:geocode": "node scripts/geocode-cavite-lgu.mjs",
    "cavite:seed": "node scripts/generate-cavite-lgu-seed.mjs",
    "cavite:sql-all": "node scripts/build-cavite-sta-complete-sql.mjs",
    "cavite:verify-view": "node scripts/verify-v-cavite-establishments.js",
    "cavite:verify-places": "node scripts/verify-places-catalog.js"
  },
  "devDependencies": {
    "xlsx": "^0.18.5"
  }
}
