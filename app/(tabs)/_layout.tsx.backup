import { Tabs } from 'expo-router';
import React from 'react';

import { HapticTab } from '@/components/haptic-tab';
import { IconSymbol } from '@/components/ui/icon-symbol';
import { Colors } from '@/constants/Colors';
import { useColorScheme } from '@/hooks/use-color-scheme';

export default function TabLayout() {
  const colorScheme = useColorScheme();
  
  // Safely get the tint color with fallback - use primary color from Colors
  const tintColor = Colors?.primary ?? '#1B4D4D';
  
  // Safely get screen options with defaults
  const defaultScreenOptions = {
    tabBarActiveTintColor: tintColor,
    headerShown: false,
    tabBarButton: HapticTab ?? undefined,
  };

  return (
    <Tabs screenOptions={defaultScreenOptions}>
      <Tabs.Screen
        name="index"
        options={{
          title: 'Home',
          tabBarIcon: ({ color }) => (
            <IconSymbol 
              size={28} 
              name="house.fill" 
              color={color ?? tintColor} 
            />
          ),
        }}
      />
      <Tabs.Screen
        name="explore"
        options={{
          title: 'Explore',
          tabBarIcon: ({ color }) => (
            <IconSymbol 
              size={28} 
              name="paperplane.fill" 
              color={color ?? tintColor} 
            />
          ),
        }}
      />
    </Tabs>
  );
}
