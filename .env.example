# Copy to `.env` in this folder (next to app.json), then restart Expo (`npx expo start`).
# Supabase: Dashboard → Project Settings → API → Project URL + anon public key

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Scripts only (never commit) — Supabase Dashboard → Project Settings → API → service_role
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Mobile Google sign-in auto-picks exp:// or LAN bridge. Supabase Redirect URLs: exp://**  cavitour://**

# Web app only: origin of the SEPARATE admin deployment (apps/admin on Vercel).
# Admin accounts that sign in on the web app are sent to this origin.
VITE_ADMIN_APP_URL=https://taracavite-admin.vercel.app

# Optional: Google Geocoding API for scripts/geocode-cavite-coordinates.mjs (else uses Nominatim)
GOOGLE_MAPS_API_KEY=

# Kira AI (https://kiraai.vn) — Edge Function secret only, never a VITE_/EXPO_PUBLIC_ var.
# Set it with: npx supabase secrets set KIRA_API_KEY=...
KIRA_API_KEY=
