# Copy to `.env` in this folder (apps/mobile), then restart Expo.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Mobile Google sign-in (iOS + Android) — apps/web NOT required.
# Supabase → Authentication → URL Configuration:
#   Site URL: http://localhost:5173
#   Redirect URLs (required for return to the app after Google):
#     cavitour://**
#     cavitour://auth/callback
#     exp://**
# Remove old LAN http://192.168.x.x redirects (they leave Safari stuck loading).
