# Copy to `.env` in this folder (apps/mobile), then restart Expo.
# Supabase: Dashboard -> Project Settings -> API -> Project URL + anon public key

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google sign-in (Supabase → Authentication → URL configuration):
#   Redirect URLs: http://localhost:5173/**  http://YOUR_LAN_IP:5173/**  exp://**  cavitour://**
#   Callback path on web: /auth/callback  (legacy /auth/google redirects there)
#   Site URL (dev): http://localhost:5173
# Physical device: run `npm run dev` in apps/web, then sign in with Google from the app.
# Optional override: EXPO_PUBLIC_OAUTH_BRIDGE_BASE_URL=http://192.168.x.x:5173
