# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Windows reserved name (breaks git/npm on some machines)
nul
nul/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts
apps/mobile/expo-go-qr.png

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files (keep secrets out of git)
.env
.env*.local

*.tsbuildinfo

# Expo local export / temp artifacts (do not commit)
apps/mobile/.expo-export-test/
apps/mobile/.tmp/

app-example

# generated native folders
/ios
/android
